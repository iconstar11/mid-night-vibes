// Writes src/game/topPicks.ts from a list of card texts or ids (JSON array on stdin, or the picks below).
// Normally run by scripts/import_top_picks.py after you edit data/card-review.xlsx.
import { readFileSync, writeFileSync } from "node:fs";

import { cardId } from "../src/game/cards.ts";

const cards: { id: string; text: string; game: string; group: string; type: string; heat: number }[] = JSON.parse(readFileSync("../data/cards.json", "utf8"));
const byId = new Map(cards.map((c) => [c.id, c]));
const input: string[] = JSON.parse(readFileSync(0, "utf8"));
const ids = [...new Set(input.map((x) => (x.startsWith("c-") ? x : cardId(x))))];
const missing = ids.filter((id) => !byId.has(id));
if (missing.length) { console.error("Not a built-in card:", missing.join(", ")); process.exit(1); }

const lines = ids.map((id) => { const c = byId.get(id)!; return `  "${id}", // ${c.game} ${c.group} ${c.type} h${c.heat}: ${c.text.replace(/\n/g, " ")}`; });
writeFileSync("src/game/topPicks.ts",
`// Top picks: the best cards, shown first in every session (and so in guests' free turns).
// GENERATED by scripts/import_top_picks.py from data/card-review.xlsx. Edit the sheet, not this file.
export const TOP_PICKS: ReadonlySet<string> = new Set([
${lines.join("\n")}
]);
`);
console.log(`${ids.length} top picks written to src/game/topPicks.ts`);
